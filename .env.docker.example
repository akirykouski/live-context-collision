# Copy to .env.docker for local Docker runs.

PORT=3000

# --- Speechmatics (live transcription) ---
SPEECHMATICS_API_KEY=

# --- Gemini (collision reasoning + service agents) ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash

# Local compose overrides this to redis://valkey:6379.
# Vultr production should use the managed Valkey URL, preferably TLS/rediss.
VALKEY_URL=

# Runtime metadata shown in /api/deployment and the Action Center panel.
WORKGRAPH_RUNTIME=local-docker
WORKGRAPH_REGION=local
WORKGRAPH_QUEUE=local Valkey
WORKGRAPH_LOAD_BALANCER=false
