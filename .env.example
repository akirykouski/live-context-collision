# --- Speechmatics (live transcription) ---
# API key from https://portal.speechmatics.com/ -> API keys
SPEECHMATICS_API_KEY=

# --- Gemini (collision reasoning) ---
# API keys from https://aistudio.google.com/apikey
# The AI gateway pools up to 4 keys and fails over in this priority order
# (a key that errors with auth/quota/5xx is benched for 60s, next key is tried).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional alternative: a single comma-separated list (merged with the above).
# GEMINI_API_KEYS=key_a,key_b
# Model used by the collision engine. Flash = low latency for live demo.
GEMINI_MODEL=gemini-2.5-flash

# Optional: server port for `npm start` (Vultr deploy)
PORT=3000

# --- Notion (optional) ---
# Set both keys to push `jira_notion` "create" actions into a real Notion
# database during a meeting. Token from
# https://www.notion.so/profile/integrations, DB shared with that integration
# (page → … → Connections). Leave empty to keep the demo fully offline.
NOTION_API_KEY=
NOTION_DATABASE_ID=
